{
  "name": "z-webkeybind",
  "version": "1.0.2",
  "private": true,
  "description": "z.WebKeyBind browser extension - automated test suite and CI pipeline",
  "scripts": {
    "lint": "eslint background.js content.js popup.js import_export.js language.js",
    "test": "jest --config jest.config.js",
    "test:unit": "jest --config jest.config.js --selectProjects unit",
    "test:integration": "jest --config jest.config.js --selectProjects integration",
    "test:e2e": "npx playwright test",
    "test:e2e:chromium": "npx playwright test --project=chromium",
    "test:e2e:firefox": "npx playwright test --project=firefox",
    "test:a11y": "npx playwright test --config=playwright.config.js --grep @a11y",
    "test:security": "jest --config jest.config.js --selectProjects security",
    "test:coverage-gate": "node scripts/coverage-gate.js",
    "test:all": "npm run lint && npm run test && npm run test:e2e:chromium"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.48.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  }
}
